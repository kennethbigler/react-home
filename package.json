{
  "name": "react-home",
  "private": true,
  "version": "5.1.0",
  "type": "module",
  "homepage": "https://kennethbigler.com/",
  "bugs": {
    "url": "https://github.com/kennethbigler/react-home/issues"
  },
  "description": "This is a site about Kenneth Bigler, Software Engineer at Intuit, including his work, interests, and resume",
  "author": "Ken Bigler <kennethbigler@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.6.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest watch",
    "test:debug": "DEBUG_PRINT_LIMIT=100000 vitest watch",
    "test:no-watch": "vitest run",
    "test:coverage": "NODE_V8_COVERAGE=codecov_reports vitest run --coverage",
    "deploy": "./scripts/deploy.sh",
    "deploy:no-fetch": "SKIP_BOTC_FETCH=1 ./scripts/deploy.sh",
    "analyze": "./scripts/analyze.sh",
    "lhci": "lhci autorun",
    "knip": "knip",
    "tsc": "tsc",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --report-unused-disable-directives",
    "lint:q": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --quiet",
    "verify": "npm run tsc && npm run knip && npm run lint && npm run test:coverage",
    "fetch-botc-scripts": "node scripts/fetch-botc-scripts.mjs",
    "a11y:live-scan": "node scripts/a11y-live-scan.mjs",
    "a11y:local-scan": "node scripts/a11y-live-scan.mjs --base-url http://localhost:5173"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@highcharts/react": "5.2.2",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "highcharts": "13.0.1",
    "jotai": "2.20.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "gts": "7.0.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "playwright": "1.55.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "keywords": [
    "Ken",
    "Kenneth",
    "Bigler",
    "Kenneth Bigler",
    "Ken Bigler",
    "Resume",
    "HTML",
    "CSS",
    "JavaScript",
    "TypeScript",
    "React",
    "Software Engineer",
    "Engineering",
    "Software Engineering",
    "Software Development",
    "Accessibility",
    "Accessibility Engineer",
    "Software Developer",
    "Web Developer",
    "Web Technologist"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "overrides": {
    "fsevents": "2.3.3"
  }
}

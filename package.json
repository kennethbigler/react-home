{
  "name": "react-home",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "homepage": "https://kennethbigler.com/",
  "bugs": {
    "url": "https://github.com/kennethbigler/react-home/issues"
  },
  "description": "This is a site about Kenneth Bigler, Software Engineer at Intuit, including his work, interests, and resume",
  "author": "Ken Bigler <kennethbigler@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.6.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest watch",
    "test:debug": "DEBUG_PRINT_LIMIT=100000 vitest watch",
    "test:no-watch": "vitest run",
    "test:coverage": "NODE_V8_COVERAGE=codecov_reports vitest run --coverage",
    "deploy": "./scripts/deploy.sh",
    "deploy:no-fetch": "SKIP_BOTC_FETCH=1 ./scripts/deploy.sh",
    "analyze": "./scripts/analyze.sh",
    "lhci": "lhci autorun",
    "knip": "knip",
    "tsc": "tsc",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --report-unused-disable-directives",
    "lint:q": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix --quiet",
    "verify": "npm run tsc && npm run knip && npm run lint && npm run test:coverage",
    "fetch-botc-scripts": "node scripts/fetch-botc-scripts.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@highcharts/react": "5.2.2",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "highcharts": "13.0.0",
    "jotai": "2.20.2",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "gts": "7.0.0",
    "jsdom": "30.0.1",
    "knip": "6.31.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "keywords": [
    "Ken",
    "Kenneth",
    "Bigler",
    "Kenneth Bigler",
    "Ken Bigler",
    "Resume",
    "HTML",
    "CSS",
    "JavaScript",
    "TypeScript",
    "React",
    "Software Engineer",
    "Engineering",
    "Software Engineering",
    "Software Development",
    "Accessibility",
    "Accessibility Engineer",
    "Software Developer",
    "Web Developer",
    "Web Technologist"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
